{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service for DevOps E2E platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:coverage:html": "jest --coverage --coverageReporters=html",
    "test:coverage:lcov": "jest --coverage --coverageReporters=lcov",
    "test:ci": "jest --ci --coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "security": "npm audit && snyk test"
  },
  "keywords": [
    "authentication",
    "jwt",
    "microservice",
    "nodejs"
  ],
  "author": "DevOps E2E Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
